<figure>
  <img
    src="{{ include.path | relative_url }}"
    {% if include.class %}
      class="{{ include.class }}"
    {% endif %}
    width="100%"
    height="auto"
    {% if include.alt %}
      alt="{{ include.alt }}"
    {% endif %}
    loading="{{ include.loading | default: 'lazy' }}"
  >
</figure>
