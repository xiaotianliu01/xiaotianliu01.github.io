<header>
  <nav id="navbar" class="navbar navbar-light navbar-expand-sm fixed-top" role="navigation">
    <div class="container">
      {% unless page.permalink == '/' %}
        <a class="navbar-brand title font-weight-lighter" href="{{ '/' | relative_url }}">
          <span class="font-weight-bold">{{ site.first_name }}</span>
          {% if site.middle_name %}{{ site.middle_name }}{% endif %}
          {{ site.last_name }}
        </a>
      {% endunless %}

      <button
        class="navbar-toggler collapsed ml-auto"
        type="button"
        data-toggle="collapse"
        data-target="#navbarNav"
        aria-controls="navbarNav"
        aria-expanded="false"
        aria-label="Toggle navigation"
      >
        <span class="sr-only">Toggle navigation</span>
        <span class="icon-bar top-bar"></span>
        <span class="icon-bar middle-bar"></span>
        <span class="icon-bar bottom-bar"></span>
      </button>

      <div class="collapse navbar-collapse text-right" id="navbarNav">
        <ul class="navbar-nav ml-auto flex-nowrap">
          <li class="nav-item {% if page.permalink == '/' %}active{% endif %}">
            <a class="nav-link" href="{{ '/' | relative_url }}">About</a>
          </li>

          {% assign sorted_pages = site.pages | where: 'nav', true | sort: 'nav_order' %}
          {% for nav_page in sorted_pages %}
            <li class="nav-item {% if page.url contains nav_page.url %}active{% endif %}">
              <a class="nav-link" href="{{ nav_page.url | relative_url }}">{{ nav_page.title }}</a>
            </li>
          {% endfor %}
        </ul>
      </div>
    </div>
  </nav>

  {% if site.enable_progressbar %}
    <progress id="progress" value="0">
      <span class="progress-bar"></span>
    </progress>
  {% endif %}
</header>
