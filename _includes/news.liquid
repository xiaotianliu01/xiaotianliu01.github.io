<div class="news">
  <div
    class="table-responsive"
    {% if include.limit and page.announcements.scrollable and site.news.size > 3 %}
      style="max-height: 60vw"
    {% endif %}
  >
    <table class="table table-sm table-borderless">
      {% assign news = site.news | reverse %}
      {% if include.limit and page.announcements.limit %}
        {% assign news_limit = page.announcements.limit %}
      {% else %}
        {% assign news_limit = site.news.size %}
      {% endif %}

      {% for item in news limit: news_limit %}
        <tr>
          <th scope="row" style="width: 20%">{{ item.display_date | default: item.date | date: '%b %Y' }}</th>
          <td>{{ item.content | remove: '<p>' | remove: '</p>' }}</td>
        </tr>
      {% endfor %}
    </table>
  </div>
</div>
