---
---
<div class="row">
  <div id="{{ entry.key }}" class="col-sm-10">
    <div class="title">{{ entry.title }}</div>

    <div class="author">
      {%- for author in entry.author_array -%}
        {%- assign clean_last_name = author.last | remove: '*' -%}
        {%- assign author_is_self = false -%}
        {%- if site.scholar.last_name contains clean_last_name and site.scholar.first_name contains author.first -%}
          {%- assign author_is_self = true -%}
        {%- endif -%}
        {%- unless forloop.first -%}
          {%- if forloop.last %} and {% else %}, {% endif -%}
        {%- endunless -%}
        {%- if author_is_self -%}<em>{%- endif -%}
        {{- author.first }} {{ clean_last_name -}}
        {%- if author.last contains '*' -%}<sup>*</sup>{%- endif -%}
        {%- if author_is_self -%}</em>{%- endif -%}
      {%- endfor -%}

      {% if entry.annotation %}
        <i
          class="fa-solid fa-circle-info ml-1"
          data-toggle="popover"
          data-placement="top"
          data-content="{{ entry.annotation | escape }}"
        ></i>
      {% endif %}
    </div>

    {% if entry.type == 'article' %}
      {% capture venue %}<em>{{ entry.journal }}</em>{% endcapture %}
    {% elsif entry.type == 'inproceedings' %}
      {% capture venue %}<em>In {{ entry.booktitle }}</em>{% endcapture %}
    {% endif %}
    {% if entry.additional_info %}
      {% capture venue %}{{ venue }} ({{ entry.additional_info }}){% endcapture %}
    {% endif %}

    <div class="periodical publication-meta">
      {{ venue | strip }}, {{ entry.year }}
      <span class="links">
        {% if entry.doi %}
          <a href="https://doi.org/{{ entry.doi }}" class="btn btn-sm z-depth-0" role="button" target="_blank" rel="noopener">DOI</a>
        {% endif %}
        {% if entry.html %}
          <a href="{{ entry.html }}" class="btn btn-sm z-depth-0" role="button" target="_blank" rel="noopener">HTML</a>
        {% endif %}
        {% if entry.pdf %}
          <a href="{{ entry.pdf }}" class="btn btn-sm z-depth-0" role="button" target="_blank" rel="noopener">PDF</a>
        {% endif %}
      </span>
    </div>

    {% if entry.note %}
      <div class="publication-note"><span class="publication-note-marker" aria-hidden="true">•</span> {{ entry.note | strip }}</div>
    {% endif %}
  </div>
</div>
